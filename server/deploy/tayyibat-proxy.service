[Unit]
Description=Tayyibat analysis proxy (Anthropic)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tayyibat/server
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
Environment=PORT=8787
# الأسرار في ملف غير مُلتزَم بالمستودع، مثال محتواه:
#   ANTHROPIC_API_KEY=sk-ant-...
#   APP_TOKEN=اختياري
EnvironmentFile=/etc/tayyibat-proxy.env
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
