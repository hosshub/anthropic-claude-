# انسخ هذا الملف إلى keystore.properties (في مجلد android/) واملأ القيم.
# لا تُضِف keystore.properties أو ملف .jks إلى git — كلاهما مُستثنى في .gitignore.
#
# لإنشاء مفتاح التوقيع (مرة واحدة):
#   keytool -genkeypair -v -keystore tayyibat-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias tayyibat
#
# ثم ضع المسار وكلمات المرور أدناه. احتفظ بنسخة آمنة من ملف .jks وكلماته —
# فقدانه يعني عدم القدرة على تحديث التطبيق على Google Play لاحقاً.

storeFile=tayyibat-release.jks
storePassword=ضع_كلمة_مرور_المتجر
keyAlias=tayyibat
keyPassword=ضع_كلمة_مرور_المفتاح
